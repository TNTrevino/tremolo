{
	"name": "tremolo-frontend",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"ng": "ng",
		"dev": "ng serve",
		"start": "ng serve",
		"build": "ng build",
		"watch": "ng build --watch --configuration development",
		"lint": "ng lint --max-warnings 0",
		"lint:fix": "ng lint --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "ng test --watch",
		"test:run": "ng test",
		"test:coverage": "ng test --coverage",
		"e2e": "playwright test",
		"e2e:baselines": "playwright test --project=baselines"
	},
	"lint-staged": {
		"*.{js,ts,html,css,md,json}": [
			"echo '🧹 Running Prettier on staged files...'",
			"npx prettier --write"
		]
	},
	"dependencies": {
		"@angular/common": "22.1.3",
		"@angular/compiler": "22.1.3",
		"@angular/core": "22.1.3",
		"@angular/forms": "22.1.3",
		"@angular/platform-browser": "22.1.3",
		"@angular/router": "22.1.3",
		"@fontsource-variable/bricolage-grotesque": "^5.2.10",
		"@fontsource-variable/inter": "^5.2.8",
		"class-variance-authority": "^0.7.0",
		"clsx": "^2.1.0",
		"opensheetmusicdisplay": "^1.9.3",
		"rxjs": "~7.8.0",
		"tailwind-merge": "^2.2.0",
		"tslib": "^2.3.0",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@angular/build": "22.1.3",
		"@angular/cli": "22.1.3",
		"@angular/compiler-cli": "22.1.3",
		"@playwright/test": "^1.62.1",
		"@testing-library/angular": "^19.1.1",
		"@testing-library/dom": "^10.4.1",
		"@eslint/js": "^10.0.1",
		"@vitest/coverage-v8": "^4.0.17",
		"angular-eslint": "^22.1.0",
		"autoprefixer": "^10.4.16",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"jsdom": "^27.4.0",
		"lint-staged": "^16.2.7",
		"postcss": "^8.4.32",
		"prettier": "^3.8.0",
		"tailwindcss": "^3.4.0",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.67.0",
		"vitest": "^4.0.17"
	}
}
