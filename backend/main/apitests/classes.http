# Tremolo — classes & assignments end-to-end
#
# One self-contained flow: register + log in a teacher, two enrolled
# students, and one outsider; create a class; join by code; assign a
# game; submit an attempt; then read it back from both the student and
# the teacher side. Interleaved are the authorization checks that are
# the real point of the feature.
#
# Run:  kulala run --tests --env local classes.http
#
# Chaining is done with client.global.set/get in JS post-response
# scripts (reliable in a batch run); tokens and ids are stashed as they
# come back. Requests run top to bottom, so each global is set before
# it's read.

# $timestamp is monotonic, so these are unique across runs against a
# persistent DB. Each is referenced only in its own REGISTER body; login
# reads the real stored email back from a *_login_email global (a
# distinct name, so a register body can never pick up a stored global).
@teacher_email  = kula_teacher_{{$timestamp}}@qa.test
@student1_email = kula_student1_{{$timestamp}}@qa.test
@student2_email = kula_student2_{{$timestamp}}@qa.test
@outsider_email = kula_outsider_{{$timestamp}}@qa.test

# ─────────────────────────── accounts ───────────────────────────

### REGISTER_TEACHER
# Kulala persists globals across runs in ~/.local/share/kulala-core/
# kulala.db. Clear them first so this run is hermetic — a stale token or
# id from a previous run can't mask a failure in this one.
< {%
	client.global.clear();
%}
POST {{base_url}}/api/auth/register
Content-Type: application/json

{ "email": "{{teacher_email}}", "password": "{{password}}", "first_name": "Terry", "last_name": "Director", "role": "TEACHER" }

> {%
	client.test("teacher registered", function () {
		client.assert(response.status === 201, "expected 201, got " + response.status);
	});
	client.global.set("teacher_login_email", response.body.user.email);
%}

### LOGIN_TEACHER
POST {{base_url}}/api/auth/login
Content-Type: application/json

{ "email": "{{teacher_login_email}}", "password": "{{password}}" }

> {%
	client.test("teacher logged in", function () {
		client.assert(response.status === 200, "expected 200, got " + response.status);
		client.assert(!!response.body.access_token, "got an access token");
	});
	client.global.set("teacher_token", response.body.access_token);
%}

### REGISTER_STUDENT1
POST {{base_url}}/api/auth/register
Content-Type: application/json

{ "email": "{{student1_email}}", "password": "{{password}}", "first_name": "Sam", "last_name": "Student", "role": "STUDENT" }

> {%
	client.test("student1 registered", function () {
		client.assert(response.status === 201, "expected 201, got " + response.status);
	});
	client.global.set("student1_id", response.body.user.id);
	client.global.set("student1_login_email", response.body.user.email);
%}

### LOGIN_STUDENT1
POST {{base_url}}/api/auth/login
Content-Type: application/json

{ "email": "{{student1_login_email}}", "password": "{{password}}" }

> {%
	client.global.set("student1_token", response.body.access_token);
%}

### REGISTER_STUDENT2
POST {{base_url}}/api/auth/register
Content-Type: application/json

{ "email": "{{student2_email}}", "password": "{{password}}", "first_name": "Sky", "last_name": "Student", "role": "STUDENT" }

> {%
	client.global.set("student2_id", response.body.user.id);
	client.global.set("student2_login_email", response.body.user.email);
%}

### LOGIN_STUDENT2
POST {{base_url}}/api/auth/login
Content-Type: application/json

{ "email": "{{student2_login_email}}", "password": "{{password}}" }

> {%
	client.global.set("student2_token", response.body.access_token);
%}

### REGISTER_OUTSIDER
POST {{base_url}}/api/auth/register
Content-Type: application/json

{ "email": "{{outsider_email}}", "password": "{{password}}", "first_name": "Ollie", "last_name": "Outsider", "role": "STUDENT" }

> {%
	client.global.set("outsider_id", response.body.user.id);
	client.global.set("outsider_login_email", response.body.user.email);
%}

### LOGIN_OUTSIDER
POST {{base_url}}/api/auth/login
Content-Type: application/json

{ "email": "{{outsider_login_email}}", "password": "{{password}}" }

> {%
	client.global.set("outsider_token", response.body.access_token);
%}

# ─────────────────────────── classes ───────────────────────────

### CREATE_CLASS
POST {{base_url}}/api/classes
Authorization: Bearer {{teacher_token}}
Content-Type: application/json

{ "name": "Symphonic Band" }

> {%
	client.test("teacher creates a class", function () {
		client.assert(response.status === 201, "expected 201, got " + response.status);
		client.assert(response.body.id > 0, "class has an id");
		client.assert(response.body.join_code.length === 6, "join code is 6 chars");
		client.assert(response.body.student_count === 0, "starts with no students");
	});
	client.global.set("class_id", response.body.id);
	client.global.set("join_code", response.body.join_code);
	// lower-cased + padded, to prove the join code is normalized on entry
	client.global.set("join_code_messy", "  " + response.body.join_code.toLowerCase() + "  ");
%}

### STUDENT_CANNOT_CREATE_CLASS
POST {{base_url}}/api/classes
Authorization: Bearer {{student1_token}}
Content-Type: application/json

{ "name": "Not allowed" }

> {%
	client.test("a student cannot create a class", function () {
		client.assert(response.status === 403, "expected 403 Forbidden, got " + response.status);
	});
%}

### JOIN_STUDENT1_MESSY_CODE
POST {{base_url}}/api/classes/join
Authorization: Bearer {{student1_token}}
Content-Type: application/json

{ "join_code": "{{join_code_messy}}" }

> {%
	client.test("student1 joins with a lower-cased, padded code", function () {
		client.assert(response.status === 200, "expected 200, got " + response.status);
		client.assert(response.body.name === "Symphonic Band", "joined the right class");
	});
%}

### JOIN_STUDENT2
POST {{base_url}}/api/classes/join
Authorization: Bearer {{student2_token}}
Content-Type: application/json

{ "join_code": "{{join_code}}" }

> {%
	client.test("student2 joins", function () {
		client.assert(response.status === 200, "expected 200, got " + response.status);
	});
%}

### JOIN_BAD_CODE
POST {{base_url}}/api/classes/join
Authorization: Bearer {{outsider_token}}
Content-Type: application/json

{ "join_code": "ZZZZZZ" }

> {%
	client.test("an unknown join code is a 404", function () {
		client.assert(response.status === 404, "expected 404, got " + response.status);
	});
%}

### ROSTER
GET {{base_url}}/api/classes/{{class_id}}/roster
Authorization: Bearer {{teacher_token}}

> {%
	client.test("roster lists both enrolled students", function () {
		client.assert(response.status === 200, "expected 200, got " + response.status);
		client.assert(response.body.length === 2, "two students on the roster, got " + response.body.length);
	});
%}

### ROSTER_NOT_OWNER
GET {{base_url}}/api/classes/{{class_id}}/roster
Authorization: Bearer {{student1_token}}

> {%
	client.test("a student cannot read the roster", function () {
		client.assert(response.status === 403, "expected 403 Forbidden, got " + response.status);
	});
%}

# ───────────────────────── assignments ─────────────────────────

### CREATE_ASSIGNMENT
POST {{base_url}}/api/classes/{{class_id}}/assignments
Authorization: Bearer {{teacher_token}}
Content-Type: application/json

{
	"title": "Week 1: Treble Notes",
	"game_type": "note",
	"config": { "scale": "C", "clef": "treble" },
	"target_accuracy": 80
}

> {%
	client.test("teacher creates an assignment", function () {
		client.assert(response.status === 201, "expected 201, got " + response.status);
		client.assert(response.body.game_type === "note", "game type stored");
		client.assert(response.body.target_accuracy === 80, "target stored");
	});
	client.global.set("assignment_id", response.body.id);
%}

### SUBMIT_ATTEMPT_STUDENT1
# An attempt is a score entry tagged with the assignment: 15/20 = 75%.
POST {{base_url}}/api/note-game/entry
Authorization: Bearer {{student1_token}}
Content-Type: application/json

{
	"user_id": {{student1_id}},
	"time_length": "00:01:00",
	"total_questions": 20,
	"correct_questions": 15,
	"notes_per_minute": 15,
	"game_type": "note",
	"assignment_id": {{assignment_id}}
}

> {%
	client.test("student1 submits a tagged attempt", function () {
		client.assert(response.status === 201, "expected 201, got " + response.status);
	});
%}

### ATTEMPT_WRONG_GAME_TYPE
# Entry says "scale" but the assignment is a "note" game — tag rejected.
POST {{base_url}}/api/note-game/entry
Authorization: Bearer {{student1_token}}
Content-Type: application/json

{
	"user_id": {{student1_id}},
	"time_length": "00:01:00",
	"total_questions": 10,
	"correct_questions": 9,
	"notes_per_minute": 9,
	"game_type": "scale",
	"assignment_id": {{assignment_id}}
}

> {%
	client.test("a mismatched game type is rejected", function () {
		client.assert(response.status === 400, "expected 400, got " + response.status);
	});
%}

### ATTEMPT_NOT_ENROLLED
# The outsider never joined the class, so they can't tag the assignment.
# (The entry endpoint collapses this to 400, not 403.)
POST {{base_url}}/api/note-game/entry
Authorization: Bearer {{outsider_token}}
Content-Type: application/json

{
	"user_id": {{outsider_id}},
	"time_length": "00:01:00",
	"total_questions": 10,
	"correct_questions": 9,
	"notes_per_minute": 9,
	"game_type": "note",
	"assignment_id": {{assignment_id}}
}

> {%
	client.test("a non-enrolled student cannot tag the assignment", function () {
		client.assert(response.status === 400, "expected 400, got " + response.status);
	});
%}

# ─────────────────────── read the results ──────────────────────

### STUDENT_ASSIGNMENTS
GET {{base_url}}/api/assignments
Authorization: Bearer {{student1_token}}

> {%
	client.test("student1 sees their assignment with progress", function () {
		client.assert(response.status === 200, "expected 200, got " + response.status);
		var a = response.body.find(function (x) { return x.id === client.global.get("assignment_id"); });
		client.assert(!!a, "the assignment is in the student's list");
		client.assert(a.attempt_count === 1, "one attempt recorded, got " + a.attempt_count);
		client.assert(a.best_accuracy === 75, "best accuracy is 75%, got " + a.best_accuracy);
	});
%}

### RESULTS_GRID
GET {{base_url}}/api/assignments/{{assignment_id}}/results
Authorization: Bearer {{teacher_token}}

> {%
	client.test("teacher grid shows every enrolled student", function () {
		client.assert(response.status === 200, "expected 200, got " + response.status);
		client.assert(response.body.length === 2, "both students appear, got " + response.body.length);
		var attempted = response.body.find(function (r) { return r.student_id === client.global.get("student1_id"); });
		var idle = response.body.find(function (r) { return r.student_id === client.global.get("student2_id"); });
		client.assert(attempted.best_accuracy === 75, "student1 shows 75%");
		client.assert(idle.attempt_count === 0, "student2 shows 0 attempts but still appears");
	});
%}

### RESULTS_NOT_OWNER
GET {{base_url}}/api/assignments/{{assignment_id}}/results
Authorization: Bearer {{student1_token}}

> {%
	client.test("a student cannot read the results grid", function () {
		client.assert(response.status === 403, "expected 403 Forbidden, got " + response.status);
	});
%}
