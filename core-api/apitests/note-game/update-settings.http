{
	"game_mode": "time",
	"time_limit": 60,
	"note_limit": 25,
	"scale": "C",
	"octave": 4,
	"low_note": "C4",
	"high_note": "C#5",
	"clef": "treble"
}

> {%
	client.test("a high_note with an accidental is rejected", function () {
		client.assert(response.status === 400, "expected 400, got " + response.status);
		client.assert(
			response.body.error === "HighNote: must be a natural note like C4",
			"unexpected error string: " + response.body.error
		);
	});
%}

### UpdateSettingsBadClef
# UpdateSettingsBadClef sends a clef outside {"treble", "bass"} -- the
# note game supports fewer clefs than the identification games.
PUT {{baseUrl}}/api/note-game/settings
Authorization: Bearer {{student_token}}
Content-Type: application/json

{
	"game_mode": "time",
	"time_limit": 60,
	"note_limit": 25,
	"scale": "C",
	"octave": 4,
	"low_note": "C4",
	"high_note": "C5",
	"clef": "alto"
}

> {%
	client.test("an unsupported clef is rejected", function () {
		client.assert(response.status === 400, "expected 400, got " + response.status);
		client.assert(
			response.body.error === "Clef: must be 'treble' or 'bass'",
			"unexpected error string: " + response.body.error
		);
	});
%}
