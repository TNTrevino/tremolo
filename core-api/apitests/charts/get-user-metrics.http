# A student's own dashboard chart data (notes per minute, accuracy,
# session count, total questions), bucketed by an interval. Self-access
# only -- a caller may only read their own metrics.
#
# Run:  kulala run --tests --env local charts/get-user-metrics.http

@student_email       = kula_user_metrics_student_{{$timestamp}}@qa.test
@other_student_email = kula_user_metrics_other_{{$timestamp}}@qa.test

### RegisterStudent
# RegisterStudent registers the student whose own metrics are read and
# expects 201.
< {%
	client.global.clear();
%}
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{ "email": "{{student_email}}", "password": "{{password}}", "first_name": "Sam", "last_name": "Student", "role": "STUDENT" }

> {%
	client.global.set("student_id", response.body.user.id);
	client.global.set("student_login_email", response.body.user.email);
%}

### LoginStudent
# LoginStudent logs the student in and stashes the access token.
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "{{student_login_email}}", "password": "{{password}}" }

> {%
	client.global.set("student_token", response.body.access_token);
%}

### RegisterOtherStudent
# RegisterOtherStudent registers a second student used to prove the
# self-only access rule.
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{ "email": "{{other_student_email}}", "password": "{{password}}", "first_name": "Other", "last_name": "Student", "role": "STUDENT" }

> {%
	client.global.set("other_student_login_email", response.body.user.email);
%}

### LoginOtherStudent
# LoginOtherStudent logs the other student in and stashes the access
# token.
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "{{other_student_login_email}}", "password": "{{password}}" }

> {%
	client.global.set("other_student_token", response.body.access_token);
%}

### GetUserMetrics
# GetUserMetrics has the student read their own metrics with defaults
# (interval=day, days=30) and expects 200 with the four chart series,
# each possibly empty for a brand new account.
GET {{baseUrl}}/api/charts/user/{{student_id}}/metrics
Authorization: Bearer {{student_token}}

> {%
	client.test("a student reads their own metrics", function () {
		client.assert(response.status === 200, "expected 200, got " + response.status);
		client.assert(Array.isArray(response.body.npm), "npm is an array");
		client.assert(Array.isArray(response.body.accuracy), "accuracy is an array");
		client.assert(Array.isArray(response.body.sessionCount), "sessionCount is an array");
		client.assert(Array.isArray(response.body.totalQuestions), "totalQuestions is an array");
	});
%}

### GetUserMetricsNotSelf
# GetUserMetricsNotSelf has the other student try to read a different
# user's metrics and expects 403 -- checked before the query params are
# even looked at.
GET {{baseUrl}}/api/charts/user/{{student_id}}/metrics
Authorization: Bearer {{other_student_token}}

> {%
	client.test("a caller cannot read another user's metrics", function () {
		client.assert(response.status === 403, "expected 403, got " + response.status);
		client.assert(response.body.error === "Access denied", "unexpected error string: " + response.body.error);
	});
%}

### GetUserMetricsNonNumericId
# GetUserMetricsNonNumericId sends a path id that isn't a number and
# expects 400.
GET {{baseUrl}}/api/charts/user/not-a-number/metrics
Authorization: Bearer {{student_token}}

> {%
	client.test("a non-numeric user id is a 400", function () {
		client.assert(response.status === 400, "expected 400, got " + response.status);
		client.assert(
			response.body.error === "Invalid user ID parameter",
			"unexpected error string: " + response.body.error
		);
	});
%}

### GetUserMetricsInvalidInterval
# GetUserMetricsInvalidInterval sends an interval outside the allowed
# set and expects 400 with the validator's own message, which echoes
# the bad value back.
GET {{baseUrl}}/api/charts/user/{{student_id}}/metrics?interval=fortnight
Authorization: Bearer {{student_token}}

> {%
	client.test("an unsupported interval is rejected with the allowed set named", function () {
		client.assert(response.status === 400, "expected 400, got " + response.status);
		client.assert(
			response.body.error === "invalid interval 'fortnight': must be one of: day, week, month, year, all",
			"unexpected error string: " + response.body.error
		);
	});
%}

### GetUserMetricsInvalidDays
# GetUserMetricsInvalidDays sends a non-numeric days value and expects
# 400 with the controller's fixed message.
GET {{baseUrl}}/api/charts/user/{{student_id}}/metrics?days=lots
Authorization: Bearer {{student_token}}

> {%
	client.test("a non-numeric days value is rejected", function () {
		client.assert(response.status === 400, "expected 400, got " + response.status);
		client.assert(
			response.body.error === "Invalid days parameter",
			"unexpected error string: " + response.body.error
		);
	});
%}
