# Changing the signed-in caller's own password.
#
# Run:  kulala run --tests --env local users/change-password.http

@student_email       = kula_change_password_student_{{$timestamp}}@qa.test
@other_student_email = kula_change_password_other_{{$timestamp}}@qa.test
@new_password        = NewTestPass456!

### RegisterStudent
# RegisterStudent registers the student whose own password is changed
# and expects 201.
< {%
	client.global.clear();
%}
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{ "email": "{{student_email}}", "password": "{{password}}", "first_name": "Sam", "last_name": "Student", "role": "STUDENT" }

> {%
	client.global.set("student_id", response.body.user.id);
	client.global.set("student_login_email", response.body.user.email);
%}

### LoginStudent
# LoginStudent logs the student in and stashes the access token.
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "{{student_login_email}}", "password": "{{password}}" }

> {%
	client.global.set("student_token", response.body.access_token);
%}

### RegisterOtherStudent
# RegisterOtherStudent registers a second student used to prove the
# self-only access rule.
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{ "email": "{{other_student_email}}", "password": "{{password}}", "first_name": "Other", "last_name": "Student", "role": "STUDENT" }

> {%
	client.global.set("other_student_login_email", response.body.user.email);
%}

### LoginOtherStudent
# LoginOtherStudent logs the other student in and stashes the access
# token.
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "{{other_student_login_email}}", "password": "{{password}}" }

> {%
	client.global.set("other_student_token", response.body.access_token);
%}

### ChangePasswordUnauthenticated
# ChangePasswordUnauthenticated sends no bearer token and expects 401.
PUT {{baseUrl}}/api/users/{{student_id}}/password
Content-Type: application/json

{ "current_password": "{{password}}", "new_password": "{{new_password}}" }

> {%
	client.test("an unauthenticated caller is rejected", function () {
		client.assert(response.status === 401, "expected 401, got " + response.status);
		client.assert(response.body.error === "Unauthorized", "unexpected error string: " + response.body.error);
	});
%}

### ChangePasswordOtherUsersID
# ChangePasswordOtherUsersID has the other student try to change the
# first student's password and expects 403.
PUT {{baseUrl}}/api/users/{{student_id}}/password
Content-Type: application/json
Authorization: Bearer {{other_student_token}}

{ "current_password": "{{password}}", "new_password": "{{new_password}}" }

> {%
	client.test("a caller cannot change another user's password", function () {
		client.assert(response.status === 403, "expected 403, got " + response.status);
		client.assert(response.body.error === "Access denied", "unexpected error string: " + response.body.error);
	});
%}

### ChangePasswordWrongCurrent
# ChangePasswordWrongCurrent sends the wrong current password and
# expects 400, NOT 401 -- see core-api/controllers/account_controller.go's
# respondAccountError: a 401 here would make
# frontend/src/app/core/interceptors/refresh.interceptor.ts retry after
# refreshing the access token, burning a round trip and silently
# resubmitting the same wrong password.
PUT {{baseUrl}}/api/users/{{student_id}}/password
Content-Type: application/json
Authorization: Bearer {{student_token}}

{ "current_password": "definitely-wrong", "new_password": "{{new_password}}" }

> {%
	client.test("a wrong current password is a 400, not a 401", function () {
		client.assert(response.status === 400, "expected 400, got " + response.status);
		client.assert(
			response.body.error === "Current password is incorrect",
			"unexpected error string: " + response.body.error
		);
	});
%}

### ChangePasswordSuccess
# ChangePasswordSuccess sends the real current password and expects 200.
PUT {{baseUrl}}/api/users/{{student_id}}/password
Content-Type: application/json
Authorization: Bearer {{student_token}}

{ "current_password": "{{password}}", "new_password": "{{new_password}}" }

> {%
	client.test("the password is changed", function () {
		client.assert(response.status === 200, "expected 200, got " + response.status);
		client.assert(response.body.message === "Password updated.", "unexpected message: " + response.body.message);
	});
%}

### LoginWithNewPassword
# LoginWithNewPassword proves the change actually took: signing in with
# the new password now succeeds.
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "{{student_login_email}}", "password": "{{new_password}}" }

> {%
	client.test("the new password signs in", function () {
		client.assert(response.status === 200, "expected 200, got " + response.status);
		client.assert(response.body.access_token !== undefined, "expected an access token");
	});
%}
