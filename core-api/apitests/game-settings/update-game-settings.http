# Saving the caller's settings for one identification game. Config is
# a JSON object of the callers choosing (each game defines its own
# shape), capped at 4096 bytes and checked in order: present, within
# the size cap, valid JSON, and an object (not a bare array/scalar).
# This is the same ConfigBlobProblem helper classes/create-assignment.http
# uses for the frozen assignment config snapshot.
#
# Run:  kulala run --tests --env local game-settings/update-game-settings.http

@student_email = kula_update_game_settings_student_{{$timestamp}}@qa.test

### RegisterStudent
# RegisterStudent registers the student actor and expects 201.
< {%
	client.global.clear();
%}
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{ "email": "{{student_email}}", "password": "{{password}}", "first_name": "Sam", "last_name": "Student", "role": "STUDENT" }

> {%
	client.global.set("student_login_email", response.body.user.email);
%}

### LoginStudent
# LoginStudent logs the student in and stashes the access token.
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "{{student_login_email}}", "password": "{{password}}" }

> {%
	client.global.set("student_token", response.body.access_token);
%}

### UpdateGameSettings
# UpdateGameSettings saves a well-formed "scale" settings blob and
# expects 200 with the game type and config echoed back.
PUT {{baseUrl}}/api/game-settings
Authorization: Bearer {{student_token}}
Content-Type: application/json

{
	"game_type": "scale",
	"config": { "tonicPool": ["C", "G"], "scaleTypes": ["major"] }
}

> {%
	client.test("a well-formed settings payload is saved", function () {
		client.assert(response.status === 200, "expected 200, got " + response.status);
		client.assert(response.body.game_type === "scale", "game_type echoes back");
	});
%}

### UpdateGameSettingsNoteGameType
# UpdateGameSettingsNoteGameType asks to save under game_type "note" --
# excluded from ValidSettingsGameTypes because the note game has its own
# typed settings endpoint (see note-game/update-settings.http).
PUT {{baseUrl}}/api/game-settings
Authorization: Bearer {{student_token}}
Content-Type: application/json

{
	"game_type": "note",
	"config": { "scale": "C" }
}

> {%
	client.test("note is not a valid game_type for this endpoint", function () {
		client.assert(response.status === 400, "expected 400, got " + response.status);
		client.assert(
			response.body.error === "GameType: must be a non-note game type",
			"unexpected error string: " + response.body.error
		);
	});
%}

### UpdateGameSettingsUnknownGameType
# UpdateGameSettingsUnknownGameType sends a game_type outside
# ValidSettingsGameTypes entirely and expects the same message as the
# note case above.
PUT {{baseUrl}}/api/game-settings
Authorization: Bearer {{student_token}}
Content-Type: application/json

{
	"game_type": "banjo",
	"config": { "scale": "C" }
}

> {%
	client.test("an unknown game_type is rejected", function () {
		client.assert(response.status === 400, "expected 400, got " + response.status);
		client.assert(
			response.body.error === "GameType: must be a non-note game type",
			"unexpected error string: " + response.body.error
		);
	});
%}

### UpdateGameSettingsConfigTooLarge
# UpdateGameSettingsConfigTooLarge sends a config blob over the 4096
# byte cap (MaxGameSettingsConfigBytes).
PUT {{baseUrl}}/api/game-settings
Authorization: Bearer {{student_token}}
Content-Type: application/json

{
	"game_type": "scale",
	"config": { "padding": "" }
}

> {%
	client.test("an oversized config blob is rejected", function () {
		client.assert(response.status === 400, "expected 400, got " + response.status);
		client.assert(
			response.body.error === "Config: too large",
			"unexpected error string: " + response.body.error
		);
	});
%}

### UpdateGameSettingsConfigNotObject
# UpdateGameSettingsConfigNotObject sends a config that is valid JSON
# but not an object -- a bare array. json.Unmarshal into a map only
# succeeds for a real object; an array, scalar, or null all land here.
PUT {{baseUrl}}/api/game-settings
Authorization: Bearer {{student_token}}
Content-Type: application/json

{
	"game_type": "scale",
	"config": []
}

> {%
	client.test("a non-object config is rejected", function () {
		client.assert(response.status === 400, "expected 400, got " + response.status);
		client.assert(
			response.body.error === "Config: must be a JSON object",
			"unexpected error string: " + response.body.error
		);
	});
%}

### UpdateGameSettingsConfigEmpty
# UpdateGameSettingsConfigEmpty omits config entirely.
PUT {{baseUrl}}/api/game-settings
Authorization: Bearer {{student_token}}
Content-Type: application/json

{
	"game_type": "scale"
}

> {%
	client.test("a missing config is rejected", function () {
		client.assert(response.status === 400, "expected 400, got " + response.status);
		client.assert(
			response.body.error === "Config: is required",
			"unexpected error string: " + response.body.error
		);
	});
%}
