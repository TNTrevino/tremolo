# Listing every teacher account. ADMIN-only. There is no self-service
# way to become an ADMIN (no route creates one outside another admin, and
# register rejects the ADMIN role), so this file can only exercise the
# two paths reachable without a seeded admin account: unauthenticated and
# authenticated-but-not-admin. The 200 path is covered by
# core-api/tests/admin_controller_test.go and admin_service_test.go,
# which seed an ADMIN row directly in the test database.
#
# Run:  kulala run --tests --env local admin/list-teachers.http

@student_email = kula_list_teachers_student_{{$timestamp}}@qa.test

### ListTeachersNoToken
# ListTeachersNoToken sends no Authorization header and expects 401 --
# RequireAuth runs before the admin-role check, so a missing token never
# reaches adminOnly.
< {%
	client.global.clear();
%}
GET {{baseUrl}}/teachers

> {%
	client.test("no token is unauthorized", function () {
		client.assert(response.status === 401, "expected 401, got " + response.status);
		client.assert(
			response.body.error === "Unauthorized",
			"unexpected error string: " + response.body.error
		);
	});
%}

### RegisterStudent
# RegisterStudent registers a non-admin actor and expects 201.
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{ "email": "{{student_email}}", "password": "{{password}}", "first_name": "Sam", "last_name": "Student", "role": "STUDENT" }

> {%
	client.global.set("student_login_email", response.body.user.email);
%}

### LoginStudent
# LoginStudent logs the student in and stashes the access token.
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "{{student_login_email}}", "password": "{{password}}" }

> {%
	client.global.set("student_token", response.body.access_token);
%}

### ListTeachersNotAdmin
# ListTeachersNotAdmin authenticates as a fresh STUDENT and expects 403
# -- a real token but the wrong role, distinct from the 401 above.
GET {{baseUrl}}/teachers
Authorization: Bearer {{student_token}}

> {%
	client.test("a non-admin token is forbidden", function () {
		client.assert(response.status === 403, "expected 403, got " + response.status);
		client.assert(
			response.body.error === "Forbidden",
			"unexpected error string: " + response.body.error
		);
	});
%}
