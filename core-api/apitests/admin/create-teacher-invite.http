# Minting a teacher invite code. ADMIN-only -- see
# admin/list-teachers.http for why this file only covers the
# unauthenticated and non-admin paths.
#
# The 201 path needs a seeded ADMIN token, which no self-service route
# grants, so it is covered by
# core-api/tests/teacher_invite_controller_test.go
# (TestCreateTeacherInviteRoute_MintsACode) and
# teacher_invite_service_test.go, which seed an ADMIN row directly in the
# test database. For the record: a valid body answers 201 with
# {"code", "note", "max_uses", "use_count", "expires_at", "created_at"},
# and a max_uses outside 1..100 answers 400 {"error": "MaxUses: must be
# between 1 and 100"}.
#
# Run:  kulala run --tests --env local admin/create-teacher-invite.http

@student_email = kula_create_invite_student_{{$timestamp}}@qa.test

### CreateTeacherInviteNoToken
# CreateTeacherInviteNoToken sends no Authorization header and expects 401
# -- RequireAuth runs before the admin-role check, so a missing token
# never reaches adminOnly.
< {%
	client.global.clear();
%}
POST {{baseUrl}}/api/admin/teacher-invites
Content-Type: application/json

{}

> {%
	client.test("no token is unauthorized", function () {
		client.assert(response.status === 401, "expected 401, got " + response.status);
		client.assert(
			response.body.error === "Unauthorized",
			"unexpected error string: " + response.body.error
		);
	});
%}

### RegisterStudent
# RegisterStudent registers a non-admin actor and expects 201.
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{ "email": "{{student_email}}", "password": "{{password}}", "first_name": "Sam", "last_name": "Student", "role": "STUDENT" }

> {%
	client.global.set("student_login_email", response.body.user.email);
%}

### LoginStudent
# LoginStudent logs the student in and stashes the access token.
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "{{student_login_email}}", "password": "{{password}}" }

> {%
	client.global.set("student_token", response.body.access_token);
%}

### CreateTeacherInviteNotAdmin
# CreateTeacherInviteNotAdmin authenticates as a fresh STUDENT and expects
# 403 -- the role check runs before the body is decoded, so even an empty
# body never reaches validation. A student who could mint a code could
# promote themselves to TEACHER, which is the whole point of the gate.
POST {{baseUrl}}/api/admin/teacher-invites
Authorization: Bearer {{student_token}}
Content-Type: application/json

{}

> {%
	client.test("a non-admin token is forbidden", function () {
		client.assert(response.status === 403, "expected 403, got " + response.status);
		client.assert(
			response.body.error === "Forbidden",
			"unexpected error string: " + response.body.error
		);
	});
%}
