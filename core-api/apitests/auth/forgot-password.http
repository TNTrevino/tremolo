# Requesting a password reset. Every response is byte-identical whether
# the address has an account or not -- RequestPasswordReset never reveals
# account existence, and the controller's failure branch answers the same
# account-independent way an outage would.
#
# Passes with every EMAIL_* variable unset: an unconfigured service queues
# the mail and holds it rather than sending (see
# core-api/services/email_service.go), so api-smoke, which sets no SMTP
# config, never dials out.
#
# Run:  kulala run --tests --env local auth/forgot-password.http

@email = kula_forgot_{{$randomInt}}@qa.test

### Register
# Register creates the account ForgotPasswordKnown asks a reset for.
< {%
	client.global.clear();
%}
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
	"email": "{{email}}",
	"password": "{{password}}",
	"first_name": "Kula",
	"last_name": "Tester",
	"role": "STUDENT"
}

> {%
	client.test("register creates the user", function () {
		client.assert(response.status === 201, "expected 201, got " + response.status);
	});
%}

### ForgotPasswordKnown
# ForgotPasswordKnown asks for a reset on the address Register just
# created and expects 200 with the generic message.
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: application/json

{
	"email": "{{email}}"
}

> {%
	client.test("a known address gets 200 with the generic message", function () {
		client.assert(response.status === 200, "expected 200, got " + response.status);
		client.assert(
			response.body.message ===
				"If an account exists for that address, a password reset link is on its way.",
			"unexpected message: " + response.body.message
		);
	});
	client.global.set("forgot_known_message", response.body.message);
%}

### ForgotPasswordUnknown
# ForgotPasswordUnknown uses an email that was never registered and
# expects the SAME 200 body as ForgotPasswordKnown -- that byte-identical
# response is the whole point of the endpoint.
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: application/json

{
	"email": "kula_forgot_nobody_{{$timestamp}}@qa.test"
}

> {%
	client.test("an unknown address gets the identical 200 body", function () {
		client.assert(response.status === 200, "expected 200, got " + response.status);
		client.assert(
			response.body.message === client.global.get("forgot_known_message"),
			"known and unknown bodies diverged: " + response.body.message
		);
	});
%}

### ForgotPasswordEmptyBody
# ForgotPasswordEmptyBody sends {} and expects the missing-email message.
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: application/json

{}

> {%
	client.test("an empty body reports the missing email", function () {
		client.assert(response.status === 400, "expected 400, got " + response.status);
		client.assert(
			response.body.error === "Email is required",
			"unexpected error string: " + response.body.error
		);
	});
%}

### ForgotPasswordBadEmail
# ForgotPasswordBadEmail sends a malformed address and expects 400.
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: application/json

{
	"email": "not-an-email"
}

> {%
	client.test("a malformed address is rejected", function () {
		client.assert(response.status === 400, "expected 400, got " + response.status);
		client.assert(
			response.body.error === "Email must be a valid email address",
			"unexpected error string: " + response.body.error
		);
	});
%}
