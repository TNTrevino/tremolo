# Redeeming a password reset token. The happy path is NOT covered here --
# the token only ever exists in the body of a queued mail, and this suite
# has no mailbox to read from. That path lives in
# core-api/tests/password_reset_service_test.go
# (TestResetPassword_EndToEnd_TheEmailedLinkWorks), which pulls the token
# straight out of the queued row. This file only exercises what a
# token-less request can: the invalid-token and validation responses.
#
# Run:  kulala run --tests --env local auth/reset-password.http

### ResetPasswordUnknownToken
# ResetPasswordUnknownToken sends a token that was never issued and
# expects 400 with the generic "invalid or expired" sentence -- unknown,
# used and expired tokens are deliberately indistinguishable.
< {%
	client.global.clear();
%}
POST {{baseUrl}}/api/auth/reset-password
Content-Type: application/json

{
	"token": "kula-never-issued-{{$timestamp}}",
	"password": "{{password}}"
}

> {%
	client.test("an unknown token is rejected", function () {
		client.assert(response.status === 400, "expected 400, got " + response.status);
		client.assert(
			response.body.error === "This password reset link is invalid or has expired.",
			"unexpected error string: " + response.body.error
		);
	});
%}

### ResetPasswordEmptyBody
# ResetPasswordEmptyBody sends {} -- two fields, two problems, sorted
# alphabetically by JSON key: "password" before "token".
POST {{baseUrl}}/api/auth/reset-password
Content-Type: application/json

{}

> {%
	client.test("both missing fields are reported, sorted by JSON key", function () {
		client.assert(response.status === 400, "expected 400, got " + response.status);
		client.assert(
			response.body.error === "Password is required, Token is required",
			"unexpected error string: " + response.body.error
		);
	});
%}

### ResetPasswordWeakPassword
# ResetPasswordWeakPassword sends a present token with a password that
# fails complexity -- Valid() checks the password regardless of whether
# the token could ever be real, so this is still a 400 from validation,
# not from the token lookup.
POST {{baseUrl}}/api/auth/reset-password
Content-Type: application/json

{
	"token": "kula-irrelevant-{{$timestamp}}",
	"password": "alllowercase"
}

> {%
	client.test("a weak password is rejected before the token is even looked up", function () {
		client.assert(response.status === 400, "expected 400, got " + response.status);
		client.assert(
			response.body.error ===
				"Password must contain at least 1 uppercase letter, " +
				"1 lowercase letter, 1 number, and 1 special character",
			"unexpected error string: " + response.body.error
		);
	});
%}
