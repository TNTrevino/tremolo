# Creating an assignment on a class: a game type, a config blob for
# that game, and optional targets. Only the owning teacher may create
# one. The two validation blocks below assert the *exact* error string,
# because httpx.ProblemsError sorts problem keys alphabetically by JSON
# field name -- see core-api/apitests/README.md.
#
# Run:  kulala run --tests --env local classes/create-assignment.http

@teacher_email       = kula_create_assignment_teacher_{{$timestamp}}@qa.test
@other_teacher_email = kula_create_assignment_other_{{$timestamp}}@qa.test

### RegisterTeacher
# RegisterTeacher registers the owning teacher and expects 201.
< {%
	client.global.clear();
%}
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{ "email": "{{teacher_email}}", "password": "{{password}}", "first_name": "Terry", "last_name": "Director", "role": "TEACHER", "invite_code": "{{teacherInviteCode}}" }

> {%
	client.global.set("teacher_login_email", response.body.user.email);
%}

### LoginTeacher
# LoginTeacher logs the owning teacher in and stashes the access token.
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "{{teacher_login_email}}", "password": "{{password}}" }

> {%
	client.global.set("teacher_token", response.body.access_token);
%}

### RegisterOtherTeacher
# RegisterOtherTeacher registers an unrelated teacher who does not own
# the class under test.
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{ "email": "{{other_teacher_email}}", "password": "{{password}}", "first_name": "Other", "last_name": "Teacher", "role": "TEACHER", "invite_code": "{{teacherInviteCode}}" }

> {%
	client.global.set("other_teacher_login_email", response.body.user.email);
%}

### LoginOtherTeacher
# LoginOtherTeacher logs the other teacher in and stashes the access
# token.
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "{{other_teacher_login_email}}", "password": "{{password}}" }

> {%
	client.global.set("other_teacher_token", response.body.access_token);
%}

### CreateClass
# CreateClass gives the owning teacher a class to assign work to.
POST {{baseUrl}}/api/classes
Authorization: Bearer {{teacher_token}}
Content-Type: application/json

{ "name": "Symphonic Band" }

> {%
	client.global.set("class_id", response.body.id);
%}

### CreateAssignment
# CreateAssignment has the owning teacher create a well-formed
# assignment and expects 201 with the game type and target stored.
POST {{baseUrl}}/api/classes/{{class_id}}/assignments
Authorization: Bearer {{teacher_token}}
Content-Type: application/json

{
	"title": "Week 1: Treble Notes",
	"game_type": "note",
	"config": { "scale": "C", "clef": "treble" },
	"target_accuracy": 80
}

> {%
	client.test("teacher creates an assignment", function () {
		client.assert(response.status === 201, "expected 201, got " + response.status);
		client.assert(response.body.game_type === "note", "game type stored");
		client.assert(response.body.target_accuracy === 80, "target stored");
	});
%}

### CreateAssignmentNotOwner
# CreateAssignmentNotOwner has an unrelated teacher try to assign work
# on a class they don't own and expects 403.
POST {{baseUrl}}/api/classes/{{class_id}}/assignments
Authorization: Bearer {{other_teacher_token}}
Content-Type: application/json

{
	"title": "Not allowed",
	"game_type": "note",
	"config": { "scale": "C" }
}

> {%
	client.test("a non-owning teacher cannot create an assignment", function () {
		client.assert(response.status === 403, "expected 403, got " + response.status);
		client.assert(response.body.error === "Forbidden", "unexpected error string: " + response.body.error);
	});
%}

### CreateAssignmentAllWrong
# CreateAssignmentAllWrong breaks all five fields on one body. Struct
# order is title, game_type, config, target_questions, target_accuracy;
# the response sorts to config, game_type, target_accuracy,
# target_questions, title. "config": [] is valid JSON but not an
# object, which is the third of ConfigBlobProblem's four cases.
POST {{baseUrl}}/api/classes/{{class_id}}/assignments
Authorization: Bearer {{teacher_token}}
Content-Type: application/json

{
	"title": "",
	"game_type": "banjo",
	"config": [],
	"target_questions": 0,
	"target_accuracy": 0
}

> {%
	client.test("assignment problems sort by JSON key, not struct order", function () {
		client.assert(response.status === 400, "expected 400, got " + response.status);
		client.assert(
			response.body.error ===
				"Config: must be a JSON object, " +
				"GameType: must be a valid game type, " +
				"TargetAccuracy: must be between 1 and 100, " +
				"TargetQuestions: must be positive, " +
				"Title: is required",
			"unexpected error string: " + response.body.error
		);
	});
%}

### CreateAssignmentOptionalTargetsOmitted
# CreateAssignmentOptionalTargetsOmitted omits target_questions and
# target_accuracy. Both are *int, so an absent field means the teacher
# set no target and its rule never runs -- only the two real problems
# come back.
POST {{baseUrl}}/api/classes/{{class_id}}/assignments
Authorization: Bearer {{teacher_token}}
Content-Type: application/json

{
	"title": "",
	"game_type": "banjo",
	"config": { "clef": "treble" }
}

> {%
	client.test("omitted optional targets produce no problems", function () {
		client.assert(response.status === 400, "expected 400, got " + response.status);
		client.assert(
			response.body.error ===
				"GameType: must be a valid game type, Title: is required",
			"unexpected error string: " + response.body.error
		);
	});
%}
