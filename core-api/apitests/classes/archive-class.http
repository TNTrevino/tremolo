# Archiving (soft-deleting) a class. Assignments and score entries stay
# for historical reporting; only the owning teacher may archive.
#
# Run:  kulala run --tests --env local classes/archive-class.http

@teacher_email       = kula_archive_teacher_{{$timestamp}}@qa.test
@other_teacher_email = kula_archive_other_teacher_{{$timestamp}}@qa.test

### RegisterTeacher
# RegisterTeacher registers the owning teacher and expects 201.
< {%
	client.global.clear();
%}
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{ "email": "{{teacher_email}}", "password": "{{password}}", "first_name": "Terry", "last_name": "Director", "role": "TEACHER", "invite_code": "{{teacherInviteCode}}" }

> {%
	client.global.set("teacher_login_email", response.body.user.email);
%}

### LoginTeacher
# LoginTeacher logs the owning teacher in and stashes the access token.
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "{{teacher_login_email}}", "password": "{{password}}" }

> {%
	client.global.set("teacher_token", response.body.access_token);
%}

### RegisterOtherTeacher
# RegisterOtherTeacher registers an unrelated teacher who does not own
# the class under test.
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{ "email": "{{other_teacher_email}}", "password": "{{password}}", "first_name": "Other", "last_name": "Teacher", "role": "TEACHER", "invite_code": "{{teacherInviteCode}}" }

> {%
	client.global.set("other_teacher_login_email", response.body.user.email);
%}

### LoginOtherTeacher
# LoginOtherTeacher logs the other teacher in and stashes the access
# token.
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "{{other_teacher_login_email}}", "password": "{{password}}" }

> {%
	client.global.set("other_teacher_token", response.body.access_token);
%}

### CreateClass
# CreateClass gives the owning teacher a class to archive.
POST {{baseUrl}}/api/classes
Authorization: Bearer {{teacher_token}}
Content-Type: application/json

{ "name": "Symphonic Band" }

> {%
	client.global.set("class_id", response.body.id);
%}

### ArchiveClassNotOwner
# ArchiveClassNotOwner has the unrelated teacher try to archive the
# class and expects 403.
DELETE {{baseUrl}}/api/classes/{{class_id}}
Authorization: Bearer {{other_teacher_token}}

> {%
	client.test("a non-owning teacher cannot archive the class", function () {
		client.assert(response.status === 403, "expected 403, got " + response.status);
		client.assert(response.body.error === "Forbidden", "unexpected error string: " + response.body.error);
	});
%}

### ArchiveClass
# ArchiveClass has the owning teacher archive the class and expects 200
# with a confirmation message.
DELETE {{baseUrl}}/api/classes/{{class_id}}
Authorization: Bearer {{teacher_token}}

> {%
	client.test("the owning teacher archives the class", function () {
		client.assert(response.status === 200, "expected 200, got " + response.status);
		client.assert(response.body.message === "Class archived", "unexpected message: " + response.body.message);
	});
%}

### ArchiveUnknownClass
# ArchiveUnknownClass targets an id nothing was ever created with and
# expects 404.
DELETE {{baseUrl}}/api/classes/999999999
Authorization: Bearer {{teacher_token}}

> {%
	client.test("archiving an unknown class is a 404", function () {
		client.assert(response.status === 404, "expected 404, got " + response.status);
		client.assert(response.body.error === "Not found", "unexpected error string: " + response.body.error);
	});
%}
