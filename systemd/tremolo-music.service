[Unit]
Description=Tremolo Music Generation Service
After=network.target

[Service]
Type=simple
User=noetrevino
WorkingDirectory=/opt/tremolo/backend/music
EnvironmentFile=/etc/tremolo/.env
ExecStart=/opt/tremolo/backend/music/env/bin/gunicorn main:app \
    -w 4 \
    -k uvicorn.workers.UvicornWorker \
    -b 0.0.0.0:${MUSIC_SERVICE_PORT}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

