#!/bin/sh

REPO_ROOT="$(git rev-parse --show-toplevel)"

staged_files_matching() {
  git diff --cached --name-only --diff-filter=ACM | grep "$1" || true
}

has_staged_files_in() {
  git diff --cached --name-only | grep -q "$1"
}

# Frontend Precommit
if has_staged_files_in "^frontend/"; then
  echo "Running Prettier on frontend files..."
  (cd "$REPO_ROOT/frontend" && npx lint-staged)
fi

if git diff --cached --name-only | grep -q "^new-frontend/"; then
  echo "🧹 Running Prettier on new-frontend files..."
  cd new-frontend && npx lint-staged
fi

# Music Service Precommit
if has_staged_files_in "^backend/music/"; then
  echo "Checking Python code formatting..."

  STAGED_PY_FILES=$(staged_files_matching "^backend/music/.*\.py$")

  if [ -n "$STAGED_PY_FILES" ]; then
    if [ -f "$REPO_ROOT/backend/music/env/bin/activate" ]; then
      . "$REPO_ROOT/backend/music/env/bin/activate"

      RELATIVE_PY_FILES=$(echo "$STAGED_PY_FILES" | sed 's|^backend/music/||')

      echo "Running Black on staged Python files..."
      echo "$RELATIVE_PY_FILES" | xargs black --quiet --check 2>/dev/null || {
        echo "Formatting with Black..."
        echo "$RELATIVE_PY_FILES" | (cd "$REPO_ROOT/backend/music" && xargs black)
        if [ $? -ne 0 ]; then
          echo "Black formatting failed."
          exit 1
        fi
      }

      echo "Running flake8 on staged Python files..."
      echo "$RELATIVE_PY_FILES" | (cd "$REPO_ROOT/backend/music" && xargs flake8 --select=E9,F63,F7,F82)
      if [ $? -ne 0 ]; then
        echo "Flake8 found critical errors."
        exit 1
      fi

      for file in $STAGED_PY_FILES; do
        git add "$REPO_ROOT/$file"
      done

      echo "Python code checks passed."
    else
      echo "Warning: Virtual environment not found at backend/music/env. Skipping Python checks."
      echo "  Run: cd backend/music && python3 -m venv env && source env/bin/activate && pip install -r requirements.txt"
    fi
  fi
fi

# User Service Precommit
if has_staged_files_in "^backend/main/"; then
  STAGED_GO_FILES=$(staged_files_matching "^backend/main/.*\.go$")

  if [ -n "$STAGED_GO_FILES" ]; then
    echo "Running gofmt on staged Go files..."
    echo "$STAGED_GO_FILES" | xargs gofmt -w

    if [ $? -ne 0 ]; then
      echo "gofmt formatting failed."
      exit 1
    fi

    for file in $STAGED_GO_FILES; do
      git add "$REPO_ROOT/$file"
    done

    echo "Go code formatting applied."
  fi
fi
