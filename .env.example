# Database
DATABASE_URL=postgresql://postgres:@localhost:5432/tremolo?sslmode=disable
DATABASE_USER=postgres
DATABASE_PW=

# Service Ports
USER_SERVICE_PORT=5001
MUSIC_SERVICE_PORT=8000

# Frontend
#
# Local dev does NOT read these. The Angular app gets its config from
# frontend/src/environments/environment.ts, a source file, and a production
# build swaps in environment.prod.ts via angular.json's fileReplacements.
# Change the URLs there, not here.
#
# They still matter on a deployed machine: .github/workflows/deploy.yml
# reads them from /etc/tremolo/.env and generates environment.prod.ts from
# them before building, so prod and QA can point at different API hosts. A
# deploy fails loudly if VITE_BACKEND_MAIN, VITE_BACKEND_MUSIC or
# VITE_GOOGLE_CLIENT_ID is unset. The names keep their VITE_ prefix from the
# React app so an existing /etc/tremolo/.env keeps working.
VITE_BACKEND_MAIN=http://localhost:5001
VITE_BACKEND_MUSIC=http://localhost:8000
VITE_APP_NAME=Tremolo

# Logging
LOG_LEVEL=DEBUG
# json for a deployed machine, where a shipper parses it. Leave it unset
# on a laptop for the readable coloured output, or set text for plain
# logfmt with no colour.
LOG_FORMAT=json
# Adds the argument list to each query log line. Off by default: those
# arguments carry email addresses, reset tokens and password hashes.
# LOG_SQL_ARGS=true

# Auth
JWT_SECRET=your-very-secure-random-string-at-least-32-characters
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_HOURS=168

# Security
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15
ALLOWED_ORIGINS=http://localhost:5100,https://domain.com

# Default Admin User
TREMOLO_DATABASE_USER=admin@example.com
TREMOLO_DATABASE_PW=changeme
TREMOLO_FIRST_NAME=Admin
TREMOLO_LAST_NAME=User

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
